# 统一行尾与文本判定，保证 Windows / Linux 检出一致，并让哈希登记绑定内容而非平台表示。
* text=auto eol=lf

# 明确二进制（避免被当作文本做行尾转换）
*.otf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.bmp binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.mp4 binary
*.mov binary
*.zip binary
*.gz binary

# 洁净室登记文件使用并集合并驱动，避免并行 PR 在热点文件上反复三路合并。
# 仅本地 git merge/rebase 生效；GitHub 网页合并与 CI 不读取本配置，详见
# scripts/git-merge-drivers/README.md。
tests/hygiene/fixtures/cleanroom_admission_metadata.json merge=hygiene-json
tests/hygiene/fixtures/admissions/issue-*.json merge=hygiene-json
tests/frontend/node-files.txt merge=hygiene-lines
