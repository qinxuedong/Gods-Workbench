{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gods Workbench",
  "version": "0.1.0",
  "identifier": "ai.godsworkbench.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Gods Workbench",
        "width": 980,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": []
  }
}
