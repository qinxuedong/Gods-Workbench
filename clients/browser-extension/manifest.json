{
  "manifest_version": 3,
  "name": "神工坊素材收集",
  "version": "1.0.0",
  "description": "把网页图片与视频直链收入本机神工坊素材库。端点仅本机回环，扩展不持有任何模型密钥。",
  "minimum_chrome_version": "111",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:2077/*",
    "http://localhost:2077/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "神工坊素材收集"
  },
  "content_scripts": [
    {
      "matches": [
        "http://127.0.0.1:2077/*",
        "http://localhost:2077/*"
      ],
      "js": [
        "src/collect-client.js",
        "content/app-bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/target-resolver.js",
        "src/collect-client.js",
        "content/collect-shortcut.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
