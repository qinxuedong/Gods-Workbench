# Copy to .env and replace host-specific values before deployment.

# Numeric owner of the bind-mounted data directories on the NAS.
GW_UID=1000
GW_GID=1000

# NAS-side HTTP port; the application listens on container port 2077.
GW_HOST_PORT=2077

# Local accounts are the simplest NAS login mode.
GW_AUTH_MODE=local_account

# Exact NAS IP or DNS hostname used in the browser URL; no scheme or port.
# Replace this reserved example value before starting the service.
GW_ALLOWED_HOSTS=nas.example.invalid

# Replace with absolute directories on the NAS. Keep data, auth and video separate.
GW_DATA_DIR=/path/to/gods-workbench/data
GW_AUTH_DIR=/path/to/gods-workbench/auth
GW_VIDEO_DIR=/path/to/gods-workbench/video
