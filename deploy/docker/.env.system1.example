# Copy to .env.system1. Replace the reserved example values before deployment.

# NAS-side port; System1 listens on container port 2077.
SYSTEM1_PORT=2078

# Exact hostname or IP used by clients to reach this NAS; no scheme or port.
GW_ALLOWED_HOSTS=nas.example.invalid

# Required Kev inference API reachable from inside the System1 container.
# Select the model on the Kev server; this adapter does not download model files.
# This reserved example host is intentionally invalid; replace it before use.
KEV_ENDPOINT=http://kev.example.invalid/v1/systemone
